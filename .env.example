# hipstraw-mm environment configuration
# Copy to .env and fill in your values.

# OpenAI API key (required for LLM calls)
OPENAI_API_KEY=sk-your-key-here

# Model used for every call (config/run.yaml reads this; it must support structured outputs)
LLM_MODEL=gpt-4o

# Brave Search API key (required for company discovery)
BRAVE_API_KEY=BSA-your-key-here

# Firestore mode: "emulator" (default, local, data lost unless exported) or "cloud" (real Firebase
# project; runs persist so you can reopen them in the viewer without re-running the pipeline).
HIPSTRAW_FIRESTORE=emulator

# Emulator mode only: emulator host, and a project ID starting with "demo-".
FIRESTORE_EMULATOR_HOST=localhost:8080
HIPSTRAW_PROJECT_ID=demo-hipstraw

# Cloud mode: remove FIRESTORE_EMULATOR_HOST, set your Firebase project ID, and point to a
# service-account key file kept OUTSIDE this repository. Never commit the key.
# HIPSTRAW_FIRESTORE=cloud
# HIPSTRAW_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/hipstraw-firestore.json
# HIPSTRAW_FIRESTORE_DATABASE=(default)

# Replay mode: "off" (live calls), "record" (live + save), "replay" (use saved)
HIPSTRAW_REPLAY=off

# Directory for recorded API responses (required when HIPSTRAW_REPLAY != "off")
HIPSTRAW_REPLAY_DIR=tests/fixtures/recorded/real

# Viewer port (default 8765)
HIPSTRAW_VIEWER_PORT=8765

# Open-weight tier for the task router (any OpenAI-compatible endpoint). The route stays off in
# config/routing.yaml; `market simulate` turns it on for one run. Example: Fireworks GLM-5.3-Flash.
OPEN_WEIGHT_BASE_URL=https://api.fireworks.ai/inference/v1
OPEN_WEIGHT_MODEL=accounts/fireworks/models/glm-5p3-flash
OPEN_WEIGHT_API_KEY=
# Sent as reasoning_effort to the open-weight model only. GLM-5.3-Flash is thinking-only: "none" is rejected, "low" keeps it short
OPEN_WEIGHT_REASONING_EFFORT=low
