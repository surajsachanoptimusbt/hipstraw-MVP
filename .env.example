# hipstraw-mm environment configuration
# Copy to .env and fill in your values.

# OpenAI API key (required for LLM calls)
OPENAI_API_KEY=sk-your-key-here

# Model used for every call (config/run.yaml reads this; it must support structured outputs)
LLM_MODEL=gpt-4o

# Brave Search API key (required for company discovery)
BRAVE_API_KEY=BSA-your-key-here

# Firestore emulator host (required — production Firestore is out of scope)
FIRESTORE_EMULATOR_HOST=localhost:8080

# Project ID passed to the Firestore client (any string works with the emulator)
HIPSTRAW_PROJECT_ID=demo-hipstraw

# Replay mode: "off" (live calls), "record" (live + save), "replay" (use saved)
HIPSTRAW_REPLAY=off

# Directory for recorded API responses (required when HIPSTRAW_REPLAY != "off")
HIPSTRAW_REPLAY_DIR=tests/fixtures/recorded/real

# Viewer port (default 8765)
HIPSTRAW_VIEWER_PORT=8765
